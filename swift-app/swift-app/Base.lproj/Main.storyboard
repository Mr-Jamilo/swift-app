                                <rect key="frame" x="53" y="169" width="287" height="101.66666666666669"/>
                                <string key="text">Since most of the cholesterol is generated by the liver, statin acts as a switch to turn off cholesterol production in the liver. Stopping the growth of plaque in the arteries.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Statin also helps reinforce existing plaque to reduce the likelihood of bursting open and causing blood clots." textAlignment="justified" lineBreakMode="wordWrap" numberOfLines="5" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="rxc-fi-tU7">
