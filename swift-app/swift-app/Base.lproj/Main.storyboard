        <!--Plaque-->
        <scene sceneID="JTK-BX-P0B">
            <objects>
                <viewController title="Plaque" id="Ut3-6z-Z5e" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Oa6-Hb-1jZ">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="783"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Plaque" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="xzD-Kn-Qf4">
                                <rect key="frame" x="153" y="50" width="87" height="38"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="38" id="6QO-3N-tEB"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="19"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Sometimes the lining of the artery gets damaged, which can be caused by high blood pressure, smoking or high blood sugar." textAlignment="justified" lineBreakMode="wordWrap" numberOfLines="7" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="0n5-5I-qC9">
                                <rect key="frame" x="53" y="96" width="287" height="89"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="89" id="ZWK-BQ-DMw"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Once the wall is damaged, cholesterol can make its way inside the artery walls." textAlignment="justified" lineBreakMode="wordWrap" numberOfLines="4" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="nNV-69-7Gj">
                                <rect key="frame" x="53" y="193" width="287" height="69"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="69" id="8JO-LI-TdH"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="The body see the cholesterol as an infection and sends white blood cells to attack it, which die as a result." textAlignment="justified" lineBreakMode="wordWrap" numberOfLines="7" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="lkW-NR-OlE">
                                <rect key="frame" x="53" y="270" width="287" height="77"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="77" id="7iC-7u-X38"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Over time, this mixture of cholesterol, dead cells, fat and calcium hardens into plaque." textAlignment="justified" lineBreakMode="wordWrap" numberOfLines="6" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="RWA-av-1QV">
                                <rect key="frame" x="53" y="355" width="287" height="78"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="78" id="W9b-sg-8ic"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="justified" lineBreakMode="wordWrap" numberOfLines="7" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Bns-cK-vwJ">
                                <rect key="frame" x="53" y="441" width="287" height="110"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="110" id="SMI-UD-CpU"/>
                                </constraints>
                                <string key="text">As plaque builds up inside the wall, it causes the arteries  to become narrower and, if a piece of (unstable) plaque breaks open (ruptures), blood clots are formed.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="justified" lineBreakMode="wordWrap" numberOfLines="9" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="HBU-Oe-mY0">
                                <rect key="frame" x="53" y="566" width="287" height="116"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="116" id="xUN-5g-uYc"/>
                                </constraints>
                                <string key="text">These blood clots can block the entire artery, causing a heart attack or stroke becuase the red blood cells can no longer transport oxygen around the body.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="JrN-2c-JtR"/>
                        <color key="backgroundColor" systemColor="systemBrownColor"/>
                        <gestureRecognizers/>
                        <constraints>
                            <constraint firstItem="JrN-2c-JtR" firstAttribute="trailing" secondItem="Bns-cK-vwJ" secondAttribute="trailing" constant="53" id="1Hf-jP-0hB"/>
                            <constraint firstItem="xzD-Kn-Qf4" firstAttribute="leading" secondItem="JrN-2c-JtR" secondAttribute="leading" constant="153" id="1r7-MT-xuc"/>
                            <constraint firstItem="xzD-Kn-Qf4" firstAttribute="top" secondItem="Oa6-Hb-1jZ" secondAttribute="top" constant="50" id="4Ty-YJ-lMZ"/>
                            <constraint firstItem="0n5-5I-qC9" firstAttribute="top" secondItem="xzD-Kn-Qf4" secondAttribute="bottom" constant="8" id="7ZT-gm-dke"/>
                            <constraint firstItem="HBU-Oe-mY0" firstAttribute="top" secondItem="Bns-cK-vwJ" secondAttribute="bottom" constant="15" id="BP3-NL-W11"/>
                            <constraint firstItem="RWA-av-1QV" firstAttribute="top" secondItem="lkW-NR-OlE" secondAttribute="bottom" constant="8" symbolic="YES" id="C7T-rR-fqY"/>
                            <constraint firstItem="xzD-Kn-Qf4" firstAttribute="top" secondItem="JrN-2c-JtR" secondAttribute="top" constant="50" id="CUB-R0-N8z"/>
                            <constraint firstItem="JrN-2c-JtR" firstAttribute="trailing" secondItem="0n5-5I-qC9" secondAttribute="trailing" constant="53" id="CuV-gS-PsL"/>
                            <constraint firstItem="HBU-Oe-mY0" firstAttribute="leading" secondItem="JrN-2c-JtR" secondAttribute="leading" constant="53" id="DQ9-CM-oId"/>
                            <constraint firstItem="JrN-2c-JtR" firstAttribute="trailing" secondItem="RWA-av-1QV" secondAttribute="trailing" constant="53" id="Gar-y7-9hb"/>
                            <constraint firstItem="JrN-2c-JtR" firstAttribute="trailing" secondItem="nNV-69-7Gj" secondAttribute="trailing" constant="53" id="L4C-2n-dhe"/>
                            <constraint firstItem="lkW-NR-OlE" firstAttribute="top" secondItem="nNV-69-7Gj" secondAttribute="bottom" constant="8" symbolic="YES" id="MMa-aS-yTu"/>
                            <constraint firstItem="HBU-Oe-mY0" firstAttribute="leading" secondItem="Bns-cK-vwJ" secondAttribute="leading" id="Mxa-ZH-Q1C"/>
